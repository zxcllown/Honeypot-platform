# Optional browser-visible backend URL.
# Leave empty for the recommended Docker setup: frontend calls /api and proxies to backend.
# Set only if frontend and backend are intentionally served from separate public origins.
PUBLIC_API_URL=

# Backend URL reachable from the frontend container during Next server-side proxying.
INTERNAL_API_URL=http://backend:8000

# Exact frontend origins allowed by backend CORS.
# Example: http://203.0.113.10:3000 or https://honeypot.example.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FRONTEND_PORT=3000
BACKEND_PORT=8000

# Use true only behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
