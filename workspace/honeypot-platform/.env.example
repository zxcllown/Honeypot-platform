# Browser-visible backend URL. On a remote server, do not leave localhost here.
# Example: http://203.0.113.10:8000 or https://api.example.com
PUBLIC_API_URL=http://localhost:8000

# Exact frontend origins allowed by backend CORS.
# Example: http://203.0.113.10:3000 or https://honeypot.example.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FRONTEND_PORT=3000
BACKEND_PORT=8000

# Use true only behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
